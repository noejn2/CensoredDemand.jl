# .dockerignore for the CensoredDemand job-runner image.
#
# Goal: keep the build context (and image) lean. Only Project.toml,
# Manifest.toml, src/ and bin/ are needed at runtime. Configs and data are
# MOUNTED at /work at `docker run` time — they are NOT baked into the image.
#
# NOTE: the Dockerfile copies files explicitly (Project.toml, Manifest.toml,
# src/, bin/), so test fixtures are already not COPYed in. This file still
# excludes them so they never enter the build context (faster context upload,
# smaller cache keys).

# --- Version control / tooling ---
.git
.gitignore
.gitattributes
.github/
**/.DS_Store

# --- The image artifacts themselves ---
Dockerfile
.dockerignore

# --- Tests + fixtures (test-only; not needed by bin/run.jl at runtime) ---
# Includes the large test/fixtures/elast/epsilons.csv and the many CSV/JSON
# oracle fixtures under test/fixtures/.
test/

# --- Benchmarks (dev-only) ---
bench/

# --- Sample outputs / scratch results (data comes via the /work mount) ---
sample/
**/out/
sample/out/

# --- Docs / editor / OS noise ---
*.md
docs/
.vscode/
.idea/
*.swp
*~

# --- Local Julia scratch state that must not leak into the image ---
# (the image builds a fresh depot at /opt/julia-depot)
.julia/
**/*.cov
**/*.jl.cov
**/*.jl.*.cov
**/*.jl.mem
LocalPreferences.toml
